{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KNOT",
  "version": "0.0.1",
  "identifier": "app.knot.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KNOT",
        "width": 1024,
        "height": 768,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "shortDescription": "KNOT is Not Only Typora — open-source Markdown editor for macOS.",
    "longDescription": "KNOT is an open-source, vibe-coded Markdown editor for macOS, inspired by Typora's single-pane live WYSIWYG experience. Built on Tauri 2 + Milkdown.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
